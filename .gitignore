# ─── Dependencies ────────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ─── Environment Variables ───────────────────────────────────────────────────
# Never commit secrets — use .env.example for templates
.env
.env.local
.env.*.local

# ─── Secrets / OAuth credentials ─────────────────────────────────────────────
# Google Cloud Console OAuth client downloads — contain the client secret
client_secret*.json
*credentials*.json

# ─── Build Outputs ───────────────────────────────────────────────────────────
build/
dist/
coverage/
.cache/

# ─── Tooling Caches ──────────────────────────────────────────────────────────
.eslintcache

# ─── Logs ────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── OS / Editor ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Allow shared VS Code config, block personal/generated files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# ─── graphify (commit the graph, ignore machine-local scratch) ───────────────
# graph.json / graph.html / GRAPH_REPORT.md / manifest.json are tracked.
# These two hold absolute paths to the local machine — regenerated each run.
graphify-out/.graphify_python
graphify-out/.graphify_root
# Content-hashed incremental-rebuild cache — derived, churns on every edit.
graphify-out/cache/

# ─── Claude Code (keep committed) ────────────────────────────────────────────
# .claude/ contains project-scoped rules — commit these
# Ignore only personal local overrides + session-local state
.claude.local.md
.claude/settings.local.json
.claude/scheduled_tasks.lock
