# Backend .env example
MONGO_URL=mongodb+srv://username:password@cluster.mongodb.net/zerodha_clone?retryWrites=true&w=majority
PORT=3002
NODE_ENV=production

# Auth — generate a strong random string (e.g. `openssl rand -hex 32`)
JWT_SECRET=

# CORS allowlist for credentialed requests. Must match the origins the
# frontend + dashboard run on (no trailing slash). In dev these default to
# localhost:3000 and localhost:3004 if unset.
FRONTEND_URL=http://localhost:3000
DASHBOARD_URL=http://localhost:3004
