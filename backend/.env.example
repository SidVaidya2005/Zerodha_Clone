# Backend .env example
MONGO_URL=mongodb+srv://username:password@cluster.mongodb.net/zerodha_clone?retryWrites=true&w=majority
PORT=3002
NODE_ENV=production

# Auth — generate a strong random string (e.g. `openssl rand -hex 32`)
JWT_SECRET=

# Google OAuth 2.0 — create a "Web application" OAuth client at
# https://console.cloud.google.com → APIs & Services → Credentials.
# GOOGLE_REDIRECT_URI must be registered verbatim in the console and match the
# /auth/google/callback route (in dev: http://localhost:3002/auth/google/callback).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3002/auth/google/callback

# CORS allowlist for credentialed requests. Must match the origins the
# frontend + dashboard run on (no trailing slash). In dev these default to
# localhost:3000 and localhost:3004 if unset.
FRONTEND_URL=http://localhost:3000
DASHBOARD_URL=http://localhost:3004
