# Dashboard environment variables
# Copy REACT_APP_* values into .env.local; the proxy server reads .env.

REACT_APP_BACKEND_URL=http://localhost:3002
REACT_APP_PROXY_URL=http://localhost:3001
# Where unauthenticated users get redirected (to /login on this host)
REACT_APP_FRONTEND_URL=http://localhost:3000

# Proxy server (server.js) — get a free key at twelvedata.com.
# Without it, /api/indian-stocks and /api/indices return errors.
TWELVEDATA_API_KEY=
# Optional tuning (defaults shown):
# TWELVEDATA_CREDITS_PER_MIN=8   # free tier per-minute credit cap
# QUOTE_TTL_MS=120000            # how long a quote is cached before refresh
# TWELVEDATA_NIFTY_SYMBOL=       # set only if your plan serves the index spot level
# TWELVEDATA_SENSEX_SYMBOL=
